#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(dirname -- "$script_dir")
install_dir=${DARN_INSTALL_DIR:-/usr/local/bin}
binary="$repo_root/macos/.build/release/darn"

if [ ! -x "$binary" ]; then
    printf 'release binary not found; run ./scripts/build-macos first\n' >&2
    exit 1
fi

install -d "$install_dir"
install -m 755 "$binary" "$install_dir/darn"

printf 'installed darn to %s/darn\n' "$install_dir"
